ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties
*.iml

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store

# ---- 运行期数据 / 备份（备份含全库数据，禁止入库）----
logs/
*.log
*.db
*.sqlite3
data/
.run/
backups/
*.sql.gz
*.sql.gz.part

# ---- Broker 凭证（只放模板/生成脚本，禁止提交口令文件）----
infra/mosquitto/passwd
infra/mosquitto/passwd.tmp
infra/mosquitto/*.passwd
infra/mosquitto/data/

# ---- 生产部署密钥 / 证书 / 本地环境（只放 .env.example 模板）----
infra/prod/.env
infra/prod/secrets/
infra/prod/nginx/certs/
infra/prod/nginx/acme/
