# ============ 运行环境 ============
# development / test / production。production 下若仍使用默认 JWT/管理员口令/SQLite，启动会直接失败
APP_ENV=development

# ============ 数据库 ============
# 生产 / 正式演示：PostgreSQL（配合 infra/docker-compose.yml 或本机 brew 安装）
DATABASE_URL=postgresql+asyncpg://iot:iot_pass@127.0.0.1:5432/iot
# 零依赖本地演示：不配置 DATABASE_URL 时默认使用 SQLite（数据落在 gateway/data/iot.db）

# ============ MQTT Broker ============
# Broker 已关闭匿名：以下口令由 scripts/mqtt_credentials.py 生成（start_all.sh 会自动导出）
# 手工运行时：python scripts/mqtt_credentials.py show
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=iot-gateway
MQTT_PASSWORD=
MQTT_CLIENT_ID=iot-gateway
# 网关自身断线时由 Broker 发布的遗嘱，便于后台识别网关离线
MQTT_WILL_TOPIC=gateway/status
# 设备凭证写入的 Broker 密码文件（相对仓库根目录）
MQTT_PASSWORD_FILE=infra/mosquitto/passwd
# 轮换后重载 Broker 的命令；留空则使用 .run/mosquitto.pid 发送 SIGHUP
# Docker：docker compose -f infra/docker-compose.yml kill -s HUP mosquitto
MQTT_RELOAD_COMMAND=
# 登录后下发给 Web / 移动端的只读主体（9001 ACL 只有 read 规则）
MQTT_WEB_USERNAME=web-console
MQTT_WEB_PASSWORD=
MQTT_MOBILE_USERNAME=mobile-console
MQTT_MOBILE_PASSWORD=

# ============ 后台鉴权 ============
JWT_SECRET=iot-platform-dev-secret-key-please-change-in-prod
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 新建/重置账号的最小口令长度（既有账号不受影响）
PASSWORD_MIN_LENGTH=8
# 演示账号 operator/viewer：开发/测试默认种子；生产默认不种子，显式 true 才种子
# SEED_DEMO_USERS=true
# 登录失败限流：同一 IP + 账号在窗口内失败达到阈值后锁定
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ============ AI 诊断（OpenAI 兼容接口）============
# 不配置 LLM_API_KEY 时自动降级为内置规则文案，链路依然完整可用
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8

# ============ 业务参数 ============
# 同设备同指标告警抑制窗口（秒）
ALERT_SUPPRESS_SECONDS=300
# 设备超过该秒数无上报则判定离线（LWT 兜底之外的二级校验）
DEVICE_OFFLINE_TIMEOUT_SECONDS=300
# 时序数据保留天数，超过自动清理
DATA_RETENTION_DAYS=90
# 离线巡检 / 数据清理执行周期（秒）
OFFLINE_SWEEP_INTERVAL_SECONDS=60
DATA_PURGE_INTERVAL_SECONDS=3600

# ============ 告警阈值（初始值；在线修改走 /api/rules/thresholds，存 rule_config 表优先于此） ============
THRESHOLD_VOLTAGE_WARNING=3.4
THRESHOLD_VOLTAGE_CRITICAL=3.2
THRESHOLD_TEMPERATURE_WARNING_HIGH=60.0
THRESHOLD_TEMPERATURE_CRITICAL_HIGH=75.0
THRESHOLD_TEMPERATURE_WARNING_LOW=-10.0
THRESHOLD_TEMPERATURE_CRITICAL_LOW=-20.0
THRESHOLD_HUMIDITY_WARNING=90.0
THRESHOLD_HUMIDITY_CRITICAL=97.0
THRESHOLD_RSSI_WARNING=-100
THRESHOLD_RSSI_CRITICAL=-110

# ============ 告警 Webhook 外推（留空关闭；critical 告警触发 POST） ============
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5.0

# ============ 跨域 ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
