# 复制为 device_app/android/key.properties 后填写真实值。
# key.properties 已被 .gitignore 忽略，禁止提交；keystore 文件同样禁止入库。
#
# 生成 keystore（在 device_app/android 目录执行，口令用密码管理器生成并妥善备份）：
#   keytool -genkeypair -v -keystore release-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias iot-release
#
# 下面的值全部是占位符，直接使用会构建失败（keystore 文件不存在/口令错误）。

storeFile=release-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=iot-release
keyPassword=REPLACE_WITH_KEY_PASSWORD
