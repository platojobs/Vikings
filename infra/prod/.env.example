# =============================================================================
# 生产环境变量模板（v1.18.0）
#
# 快速开始（推荐）：./scripts/prod_up.sh
#   脚本会自动复制本模板为 infra/prod/.env、生成全部随机密钥/口令/证书，
#   然后构建并启动整套栈。手工部署时：
#     cp infra/prod/.env.example infra/prod/.env
#   并把所有 <CHANGE_ME> 替换为真实值（见下方“生成方式”）。
#
# 安全约定：
#   - infra/prod/.env 已被 .gitignore 覆盖，禁止入库；
#   - 本模板中的口令/密钥一律是占位符；
#   - 生产启动会做 fail-fast 校验：默认/弱密钥、弱口令、SQLite 都会拒绝启动。
# =============================================================================

APP_ENV=production

# ---- 对外入口 ----------------------------------------------------------------
# 浏览器访问的公开源；用于 CORS 白名单（同源部署其实不需要 CORS）
PUBLIC_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
# 设备 MQTT over TCP 的宿主机端口
MQTT_PORT=1883

# ---- PostgreSQL（仅容器内网，不发布宿主机端口）------------------------------
POSTGRES_USER=iot
POSTGRES_DB=iot
# 必改：openssl rand -hex 24
POSTGRES_PASSWORD=<CHANGE_ME>

# ---- 网关鉴权 ----------------------------------------------------------------
# 必改：openssl rand -hex 48（生产要求 ≥32 字符且不能是仓库公开默认值）
JWT_SECRET=<CHANGE_ME>
ADMIN_USERNAME=admin
# 必改：至少 8 位、不能是常见弱口令；openssl rand -hex 16
ADMIN_PASSWORD=<CHANGE_ME>
PASSWORD_MIN_LENGTH=8
# 生产固定不种演示账号（operator/viewer）
SEED_DEMO_USERS=false

# 登录失败锁定（网关自身实现，按 IP+账号）
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ---- MQTT 服务身份与客户端只读身份 ------------------------------------------
# 口令由 scripts/mqtt_credentials.py 生成并写入 Broker passwd；
# prod_up.sh 会自动从 .run/mqtt/credentials.json 回填下面三个变量。
MQTT_USERNAME=iot-gateway
MQTT_WEB_USERNAME=web-console
MQTT_MOBILE_USERNAME=mobile-console
MQTT_PASSWORD=<GENERATED>
MQTT_WEB_PASSWORD=<GENERATED>
MQTT_MOBILE_PASSWORD=<GENERATED>

# 容器内路径：与 Broker 共享 infra/prod/secrets/mosquitto.passwd
MQTT_PASSWORD_FILE=/run/secrets/mosquitto.passwd
# 网关与 Broker 以不同 uid 运行；0644 仅含 PBKDF2 hash，Broker 才能读取。
# 如自行改为 0640，需要把两容器用户放到同一组（不推荐，跨平台不可移植）。
MQTT_PASSWORD_FILE_MODE=644
# 容器内无法向 Broker 发 SIGHUP；轮换后按 docs/operations.md 重启/重载 Broker
MQTT_RELOAD_COMMAND=

# ---- 容器运行用户 ------------------------------------------------------------
# 必改：prod_up.sh 自动写入 `id -u` / `id -g`。
# 用于网关以非 root 运行并写入共享密码文件；必须与 infra/prod/secrets 属主一致。
DEPLOY_UID=1000
DEPLOY_GID=1000

# ---- 可选：AI 诊断 / 告警外推 / 时区 ----------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ALERT_WEBHOOK_URL=
TZ=Asia/Shanghai
